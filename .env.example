# LanguageTool User Proxy - Environment Configuration
# Copy this file to .env and fill in your values
# The .env file is automatically loaded on startup

# Server Configuration
PORT=8080
DATABASE_PATH=./data/languagetool.db

# OIDC Configuration (Required)
# Replace with your OIDC provider settings
OIDC_ISSUER_URL=https://your-keycloak.example.com/realms/yourrealm
OIDC_CLIENT_ID=languagetool-proxy
OIDC_CLIENT_SECRET=your-client-secret-here
OIDC_REDIRECT_URI=https://your-domain.com/callback

# Optional: OIDC scopes (default: openid profile email)
OIDC_SCOPE=openid profile email

# LanguageTool Backend URL (Required)
BACKEND_URL=http://localhost:8080

# Session Configuration
# Session duration in hours (default: 24)
SESSION_DURATION_HOURS=24

# Cookie Secret (Optional - auto-generated if not set)
# Generate a random secret: openssl rand -hex 32
# COOKIE_SECRET=your-random-secret-key-here
